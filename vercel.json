{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "server.mjs": {
      "maxDuration": 60,
      "includeFiles": "{index.html,frontend.js,queue.js,cover.js,styles.css,assets/**,config/**,data/collected.json,data/intelligence.json,data/manual-social.json}"
    },
    "api/[...path].js": {
      "maxDuration": 60
    }
  }
}
