OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible gateway.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Required only for X.com recent search.
X_BEARER_TOKEN=

# Server / collection settings.
PORT=4173
HOST=127.0.0.1
REFRESH_INTERVAL_HOURS=24
FETCH_TIMEOUT_MS=18000
AGENT_ITEM_LIMIT=24
AGENT_PER_SOURCE_LIMIT=5
AGENT_MIN_DISPLAY_SCORE=45
DAILY_RECOMMENDATION_MIN=3
DAILY_RECOMMENDATION_MAX=5
BACKUP_TOPIC_LIMIT=20
LLM_TIMEOUT_MS=45000
LLM_CONCURRENCY=4
# 小红书文案风格强度，0.7~0.9 更有网感；不配则默认 0.8。
LLM_TEMPERATURE=0.8
